# Telegram
TELEGRAM_BOT_TOKEN=123456789:your-bot-token-from-botfather
TELEGRAM_WEBHOOK_SECRET=generate-a-random-string-here

# Gemini
GEMINI_API_KEY=your-gemini-api-key-from-aistudio

# Supabase (server-side only — service role key, never expose to client)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin dashboard
ADMIN_PASSWORD=choose-a-strong-passcode
SESSION_SECRET=generate-a-long-random-string-here
